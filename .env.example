# ── Supabase (Dashboard → Project Settings → API Keys) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of the app, used in auth emails. Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only secrets (never prefix with NEXT_PUBLIC_) ────────────────────
# Google sign-in (the only way in): Google Cloud → Google Auth Platform → Clients → Web application.
# Redirect URI: <site>/api/auth/google/callback. Paste the same client into Supabase's Google provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase → Project Settings → API Keys → Secret keys (or legacy service_role).
# Bypasses Row Level Security; server only (workers, email sync, rate limits, account deletion).
SUPABASE_SECRET_KEY=sb_secret_xxx

# Company briefings:
#   mock   — free sample data, no keys
#   tavily — Tavily search + Gemini writes from the results (both have free tiers)
#   gemini — Gemini with built-in Google Search (needs billing enabled on the key)
AI_PROVIDER=mock
# https://aistudio.google.com/apikey — needed for tavily and gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Used when the main model is busy or too slow
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# https://app.tavily.com — free 1,000 searches/month, no card. Needed for tavily.
TAVILY_API_KEY=

# Protects POST /api/worker/briefs (scheduled retries). Generate: openssl rand -hex 32
WORKER_SECRET=
# Max briefing generations per user per 24h
# Accounts without per-user limits (e.g. the owner), comma-separated. Shared monthly caps still apply.
UNLIMITED_EMAILS=
BRIEFS_DAILY_LIMIT=2
# Briefings for the whole app per month (each uses ~11–15 Tavily searches; free plan: 1,000/month)
BRIEFS_MONTHLY_LIMIT=65
# Max AI tool runs (analyze / tailor CV / interview prep) per user per 24h
AI_DAILY_LIMIT=30

# ── Outlook email integration ───────────────────────────────────────────────
# Azure portal → Microsoft Entra ID → App registrations (personal Microsoft accounts),
# redirect URI: <site>/api/email/outlook/callback, API permissions: Mail.Read, User.Read, offline_access
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# ── Gmail integration (optional) ────────────────────────────────────────────
# Google Cloud → enable the Gmail API → OAuth client (Web application),
# redirect URI: <site>/api/email/gmail/callback, scope: gmail.readonly (see README)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Encrypts stored mailbox (Outlook / Gmail) refresh tokens. Generate: openssl rand -hex 32
EMAIL_TOKEN_KEY=
